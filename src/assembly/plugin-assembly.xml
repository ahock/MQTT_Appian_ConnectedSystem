<?xml version="1.0" encoding="UTF-8"?>
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.0 http://maven.apache.org/xsd/assembly-2.1.0.xsd">
    <!--
      Produces the deployable Appian plug-in artifact: a single jar that contains the
      compiled plug-in classes, the plug-in's own .java sources, the appian-plugin.xml descriptor
      and i18n resources, the third-party notice, and the bundled runtime dependencies (Eclipse
      Paho) under META-INF/lib/. The Appian SDK is marked 'provided' and is therefore excluded.
    -->
    <id>plugin</id>
    <formats>
        <format>jar</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>

    <fileSets>
        <!-- Compiled plug-in classes and bundled resources (descriptor + property files). -->
        <fileSet>
            <directory>${project.build.outputDirectory}</directory>
            <outputDirectory>/</outputDirectory>
        </fileSet>

        <!--
          AppMarket policy: the plug-in's source code must be contained within the executable jar
          submitted for review. The sources ship root-mirrored, so each .java sits beside the
          .class it compiles to. Only src/main/java is included, which keeps test sources out of
          the shipped artifact.
        -->
        <fileSet>
            <directory>${project.basedir}/src/main/java</directory>
            <outputDirectory>/</outputDirectory>
            <includes>
                <include>**/*.java</include>
            </includes>
        </fileSet>

        <!-- Third-party license notice for the bundled Eclipse Paho client. -->
        <fileSet>
            <directory>${project.basedir}</directory>
            <outputDirectory>/</outputDirectory>
            <includes>
                <include>THIRD-PARTY-NOTICES.md</include>
            </includes>
        </fileSet>
    </fileSets>

    <dependencySets>
        <!--
          Bundle runtime-scoped third-party libraries as nested jars under META-INF/lib/, which is
          where the Appian plug-in classloader resolves them from. Paho is referenced directly by
          MqttPublisher, so it must resolve. useProjectArtifact=false + scope runtime keep the
          provided-scope connected-systems-core and connected-systems-client out of the archive.
        -->
        <dependencySet>
            <outputDirectory>META-INF/lib</outputDirectory>
            <useProjectArtifact>false</useProjectArtifact>
            <scope>runtime</scope>
        </dependencySet>
    </dependencySets>
</assembly>
